#!/usr/bin/env bash
set -e

repo=$(cd "$(dirname "$0")" && pwd)
compose=(docker compose -f "$repo/compose.yaml")
args=()
use_db=true
rife=false
export DOOM_PLAY_VARIANT=
build=()
sound=true
while (( $# )); do
    case "$1" in
        --wad|--wad=*)
            if [[ $1 == --wad ]]; then
                shift
                wad=$1
            else
                wad=${1#--wad=}
            fi
            if [[ ! -f $wad ]]; then
                echo "WAD file not found: $wad" >&2
                exit 2
            fi
            [[ $wad == /* ]] || wad="$PWD/$wad"
            export DOOM_WAD_PATH="$wad"
            args+=(--wad /app/assets/doom1.wad)
            ;;
        --help|-h)
            sound=false
            use_db=false
            args+=("$1")
            ;;
        --mute)
            sound=false
            args+=("$1")
            ;;
        --rife)
            rife=true
            export DOOM_PLAY_VARIANT=-rife
            build=(--build)
            args+=("$1")
            ;;
        --dsn|--dsn=*)
            use_db=false
            args+=("$1")
            ;;
        *) args+=("$1") ;;
    esac
    shift
done

if [[ $use_db == true ]]; then
    "${compose[@]}" up -d --wait db
    "${compose[@]}" exec -T db psql -Xq -v ON_ERROR_STOP=1 -v rife="$rife" -U postgres -d doom <<'SQL'
\o /dev/null
SELECT pg_advisory_lock(hashtext('doom.install'));
SELECT to_regnamespace('doom') IS NULL AS install \gset
\if :install
\i /app/install.sql
\else
SELECT to_regprocedure('doom.prepare_wad(bytea,text)') IS NULL AS upgrade \gset
\if :upgrade
BEGIN;
\i /app/engine/wad/prepared.sql
COMMIT;
\endif
SELECT NOT coalesce(proconfig @> ARRAY['plan_cache_mode=force_generic_plan'], false) AS upgrade_mesh
FROM pg_proc WHERE oid='doom.compile_level(bigint)'::regprocedure \gset
\if :upgrade_mesh
ALTER FUNCTION doom.compile_level(bigint) SET plan_cache_mode=force_generic_plan;
\endif
SELECT prosqlbody IS NULL AS upgrade_palette
FROM pg_proc WHERE oid='doom.frame_palette(bigint)'::regprocedure \gset
\if :upgrade_palette
\i /app/engine/render/palette.sql
\endif
\if :rife
SELECT to_regprocedure('doom.poll_frame_low(bigint,bigint,bigint,text)') IS NULL AS install_low \gset
\if :install_low
BEGIN;
\i /app/engine/render/lowres.sql
COMMIT;
\endif
\endif
\endif
SQL
else
    compose=(docker compose -f "$repo/compose.services.yaml")
fi

# Docker Desktop cannot play PCM on the host's speakers.
if [[ $sound == true && -t 0 && -t 1 ]]; then
    for player in afplay paplay aplay; do
        command -v "$player" >/dev/null || continue
        audio=$(mktemp -d)
        touch "$audio/shots"
        mkfifo "$audio/events"
        tail -n +1 -f "$audio/shots" > "$audio/events" &
        follower=$!
        (
            while IFS= read -r event; do
                "$player" "$audio/pistol.wav" </dev/null &
            done
        ) < "$audio/events" >/dev/null 2>&1 &
        listener=$!
        trap 'kill "$follower" "$listener" 2>/dev/null || true; wait || true; rm -rf "$audio"' EXIT
        "${compose[@]}" run --rm "${build[@]}" -v "$audio:/audio" -e DOOM_AUDIO_DIR=/audio play "${args[@]}"
        exit
    done
fi
exec "${compose[@]}" run --rm "${build[@]}" play "${args[@]}"
