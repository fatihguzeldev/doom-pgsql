#!/usr/bin/env bash
set -e

repo=$(cd "$(dirname "$0")" && pwd)
compose=(docker compose --project-directory "$repo")
args=()
use_db=true
rife=false
export DOOM_PLAY_VARIANT=
build=(--build)
sound=true
while (( $# )); do
    arg=$1
    case "$arg" in
        --wad|--wad=*)
            if [[ $arg == --wad ]]; then
                shift
                wad=$1
            else
                wad=${arg#--wad=}
            fi
            if [[ ! -f $wad ]]; then
                echo "WAD file not found: $wad" >&2
                exit 2
            fi
            [[ $wad == /* ]] || wad="$PWD/$wad"
            export DOOM_WAD_PATH="$wad"
            args+=(--wad)
            arg=/app/assets/doom1.wad
            ;;
        --help|-h) sound=false; use_db=false; build=() ;;
        --mute) sound=false ;;
        --dsn|--dsn=*) use_db=false ;;
        --rife)
            rife=true
            export DOOM_PLAY_VARIANT=-rife
            ;;
    esac
    args+=("$arg")
    shift
done

if [[ $use_db == true ]]; then
    "${compose[@]}" up -d --wait db
    "${compose[@]}" exec -T db psql -Xq -v ON_ERROR_STOP=1 -v rife="$rife" -U postgres -d doom -f /app/engine/bootstrap.sql
else
    compose+=(--env-file /dev/null)
fi

# the container cannot access the host's audio device
if [[ $sound == true && -t 0 && -t 1 ]]; then
    for player in afplay paplay aplay; do
        command -v "$player" >/dev/null || continue
        audio=$(mktemp -d)
        touch "$audio/events"
        bash "$repo/client/audio.sh" "$audio" "$player" &
        listener=$!
        trap 'kill "$listener" 2>/dev/null || true; wait "$listener" 2>/dev/null || true; rm -rf "$audio"' EXIT
        "${compose[@]}" run --rm "${build[@]}" -v "$audio:/audio" -e DOOM_AUDIO_DIR=/audio play "${args[@]}"
        exit
    done
fi
exec "${compose[@]}" run --rm "${build[@]}" play "${args[@]}"
